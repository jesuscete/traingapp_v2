{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traingapp.dev/contracts/exercise.json",
  "title": "Exercise",
  "description": "Ejercicio individual dentro de una sesión de entrenamiento.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sets": {
      "type": "integer",
      "minimum": 1
    },
    "reps": {
      "type": "integer",
      "minimum": 1
    },
    "perSetReps": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "Repeticiones por serie cuando no son uniformes, p. ej. [8, 7, 7, 5]."
    },
    "weightKg": {
      "type": "number",
      "minimum": 0
    },
    "durationMinutes": {
      "type": "number",
      "minimum": 0
    },
    "distanceMeters": {
      "type": "number",
      "minimum": 0
    },
    "restSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Descanso aproximado entre series (opcional)."
    },
    "rpe": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Esfuerzo percibido del ejercicio (opcional)."
    },
    "volumeKg": {
      "type": "number",
      "minimum": 0,
      "description": "Volumen del ejercicio (sets * reps * weightKg) cuando aplica."
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
