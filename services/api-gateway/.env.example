APP_ENV=development
APP_REDIS_URL=redis://localhost:6379/0
APP_DATABASE_URL=postgresql+asyncpg://traingapp:traingapp@localhost:5432/traingapp
APP_JWT_SECRET=dev-secret-change-me-0123456789abcdef
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_INTERNAL_TOKEN=internal-dev-token
# Orígenes CORS separados por comas. Para usar la web desde el móvil en la LAN,
# añade la IP del PC, p. ej. http://192.168.1.50:3000
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# En APP_ENV=production el arranque falla si JWT_SECRET/INTERNAL_TOKEN son los de
# ejemplo o tienen < 32 caracteres, o si DATABASE_URL usa credenciales de desarrollo.
# Timeout hacia ai-parser: debe cubrir el del LLM (90 s) más un reintento.
APP_AI_PARSER_TIMEOUT_SECONDS=200
# Nutrición (M5). USDA FoodData Central: clave gratuita en https://fdc.nal.usda.gov/api-key-signup
# (DEMO_KEY funciona pero tiene un límite muy bajo por hora).
APP_USDA_API_KEY=DEMO_KEY
APP_OFF_BASE_URL=https://es.openfoodfacts.org
# Garmin (M6.2): sondeo periódico de la API personal (0 = desactivado) e historial inicial.
APP_GARMIN_POLL_MINUTES=30
APP_GARMIN_HISTORY_DAYS=30
# Clave Fernet para cifrar secretos en BD (clave de Garmin). Vacía = derivada de APP_JWT_SECRET.
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
