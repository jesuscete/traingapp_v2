APP_ENV=development
APP_REDIS_URL=redis://localhost:6379/0
APP_INTERNAL_API_URL=http://localhost:8000
# En APP_ENV=production debe cambiarse (>= 32 caracteres, igual que en api-gateway).
APP_INTERNAL_TOKEN=internal-dev-token

# --- Proveedor LLM (ADR-002) ---
# APP_LLM_PROVIDER: claude_cli | ollama | openai | stub
#   claude_cli: usa el CLI `claude` instalado y autenticado (suscripción de Claude Code).
#               Solo para uso personal/local; en producción usar API key.
#   ollama: local y gratuito (docker run -d -p 11434:11434 ollama/ollama)
#   openai: compatible con cualquier API /v1/chat/completions (Gemini free, Groq, ...)
#   stub: parser regex determinista (fallback siempre disponible)
APP_LLM_PROVIDER=stub
# Solo para proveedor "claude_cli": alias (haiku|sonnet|opus) o id de modelo.
APP_CLAUDE_MODEL=sonnet
APP_CLAUDE_CLI_PATH=claude
APP_LLM_MODEL=qwen2.5:3b
APP_OLLAMA_URL=http://localhost:11434
# Solo para proveedor "openai":
APP_OPENAI_API_KEY=
APP_OPENAI_BASE_URL=https://api.openai.com/v1
APP_LLM_TIMEOUT_SECONDS=90
# Contexto maximo (limita la caché KV en RAM del LLM local; 4096-8192 es suficiente
# para generar planes; subirlo multiplica el consumo de memoria de ollama).
APP_LLM_CONTEXT_LENGTH=8192
# Tope de tokens de salida para la evaluacion de rutinas (menor latencia en CPU).
APP_LLM_REVIEW_MAX_TOKENS=800
